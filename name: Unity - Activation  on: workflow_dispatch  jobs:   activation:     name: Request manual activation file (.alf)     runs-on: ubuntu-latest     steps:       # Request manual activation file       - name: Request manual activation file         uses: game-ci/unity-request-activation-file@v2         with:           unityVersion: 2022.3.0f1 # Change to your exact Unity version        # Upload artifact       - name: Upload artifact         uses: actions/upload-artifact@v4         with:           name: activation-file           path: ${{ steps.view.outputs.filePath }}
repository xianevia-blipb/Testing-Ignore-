name: Unity - Activation

on: workflow_dispatch

jobs:
  activation:
    name: Request manual activation file (.alf)
    runs-on: ubuntu-latest
    steps:
      # Request manual activation file
      - name: Request manual activation file
        id: getManualLicenseFile
        uses: game-ci/unity-request-activation-file@v2
        with:
          unityVersion: 5.3.0f4 # <--- Fixed: Changed to your exact version

      # Upload artifact
      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: activation-file
          path: ${{ steps.getManualLicenseFile.outputs.filePath }} # <--- Fixed: Pointed to the correct output step
